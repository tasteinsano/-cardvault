<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>CardVault</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#090b10;color:#fff;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",Arial,sans-serif}.app{max-width:700px;margin:auto;padding:18px 16px 36px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}h1{margin:0;font-size:30px}.muted{color:#9ca3af}.card{background:#151922;border:1px solid #2b3240;border-radius:18px;padding:18px;margin-top:14px}button{border:0;border-radius:14px;padding:14px 18px;font-size:17px;font-weight:700;color:#fff;background:#2563eb}.secondary{background:#252b36}.full{width:100%;margin-top:12px}video{width:100%;border-radius:16px;background:#000;aspect-ratio:3/4;object-fit:cover}.hidden{display:none}.status{padding:13px 14px;border-radius:12px;background:#202632;margin-top:12px;line-height:1.4}.result{display:flex;gap:14px;align-items:flex-start}.result img{width:105px;border-radius:10px}.name{font-size:21px;font-weight:800;margin-bottom:5px}.price{font-size:18px;color:#86efac;font-weight:700}.small{font-size:13px;color:#aab2bf}.choices{display:grid;gap:10px;margin-top:14px}.choice{display:flex;gap:12px;align-items:center;text-align:left;background:#202632;border:1px solid #333b49}.choice img{width:58px;border-radius:6px}.choice .meta{flex:1}.badge{display:inline-block;padding:3px 7px;border-radius:7px;background:#263142;color:#93c5fd;font-size:12px;margin-top:4px}.nav{display:flex;gap:8px;margin-bottom:14px}.nav button{flex:1}
</style>
</head>
<body>
<div class="app">
<div class="top"><h1>CardVault</h1><span class="muted">Magic Card Scanner</span></div>
<div class="nav"><button id="scanTab">📷 Scan Card</button><button class="secondary" id="collectionTab">🗃 Collection</button><button class="secondary" id="decksTab">🃏 Decks</button></div>
<section id="scanner" class="card">
<h2>Scan a card</h2><p class="muted">No typing required. Hold one Magic card in view, then scan it. CardVault will read the name and collector number when possible.</p>
<video id="video" autoplay playsinline muted></video>
<button id="start" class="full">Start Camera</button>
<button id="capture" class="full secondary hidden">📸 Scan This Card</button>
<div id="status" class="status">Tap Start Camera to begin.</div>
<canvas id="canvas" class="hidden"></canvas>
</section>
<section id="resultCard" class="card hidden"><h2>Card Found</h2><div id="result"></div><button id="again" class="full secondary">Scan Another Card</button></section>
<section id="collection" class="card hidden"><h2>My Collection</h2><div id="cards"></div></section>
<section id="decks" class="card hidden">
<h2>Deck Builder</h2>
<p class="muted">Create a deck yourself, or let CardVault build a 60-card casual deck from cards you've scanned.</p>
<div class="card" style="margin-top:12px">
<h3 style="margin-top:0">🤖 Build a Deck for Me</h3>
<div style="display:grid;gap:9px">
<select id="buildStyle" style="padding:14px;border-radius:12px;border:1px solid #333b49;background:#202632;color:#fff;font-size:16px">
<option value="balanced">⚖️ Balanced</option>
<option value="aggro">⚔️ Aggro / Attack</option>
<option value="control">🧙 Control</option>
<option value="creatures">🐉 Creature-heavy</option>
<option value="surprise">🎲 Surprise Me</option>
</select>
<select id="buildColors" style="padding:14px;border-radius:12px;border:1px solid #333b49;background:#202632;color:#fff;font-size:16px">
<option value="any">🌈 Any colors</option>
<option value="W">⚪ White</option>
<option value="U">🔵 Blue</option>
<option value="B">⚫ Black</option>
<option value="R">🔴 Red</option>
<option value="G">🟢 Green</option>
<option value="WU">⚪🔵 Azorius</option>
<option value="BR">⚫🔴 Rakdos</option>
<option value="RG">🔴🟢 Gruul</option>
<option value="BG">⚫🟢 Golgari</option>
<option value="UR">🔵🔴 Izzet</option>
</select>
<input id="autoDeckName" placeholder="Deck name (optional)" style="padding:14px;border-radius:12px;border:1px solid #333b49;background:#202632;color:#fff;font-size:16px">
<button id="buildDeck">✨ Build Deck for Me</button>
</div>
<div id="buildStatus" class="status hidden"></div>
</div>
<div style="display:flex;gap:8px;margin-top:12px">
<input id="deckName" placeholder="Or create an empty deck" style="flex:1;padding:14px;border-radius:12px;border:1px solid #333b49;background:#202632;color:#fff;font-size:16px">
<button id="createDeck">➕ Create</button>
</div>
<div id="deckList"></div>
<div id="deckEditor" class="hidden"></div>
</section>
</div>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<script>
const video=document.getElementById('video'),canvas=document.getElementById('canvas'),statusEl=document.getElementById('status'),captureBtn=document.getElementById('capture'),startBtn=document.getElementById('start'),resultCard=document.getElementById('resultCard'),resultEl=document.getElementById('result'),collection=document.getElementById('collection'),scanner=document.getElementById('scanner'),decks=document.getElementById('decks');let stream=null;const KEY='cardvault_cards',DECK_KEY='cardvault_decks';
function setStatus(t){statusEl.textContent=t}function cards(){try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch(e){return[]}}function saveCards(c){localStorage.setItem(KEY,JSON.stringify(c))}
function getDecks(){try{return JSON.parse(localStorage.getItem(DECK_KEY)||'[]')}catch(e){return[]}}
function saveDecks(d){localStorage.setItem(DECK_KEY,JSON.stringify(d))}
function cardKey(c){return c.id||((c.name||'')+'|'+(c.set||'')+'|'+(c.collector||''))}
function collectionCounts(){const out={};cards().forEach(c=>{const k=cardKey(c);if(!out[k])out[k]={...c,qty:0};out[k].qty++});return Object.values(out)}
function renderDecks(){const ds=getDecks(),list=document.getElementById('deckList');list.innerHTML=ds.length?ds.map((d,i)=>`<button class="choice full" style="margin-top:10px" data-deck="${i}"><span class="meta"><b>${esc(d.name)}</b><br><span class="small">${d.cards.reduce((s,c)=>s+(c.qty||0),0)} cards</span></span><span>›</span></button>`).join(''):'<p class="muted">No decks yet. Create your first deck above.</p>';list.querySelectorAll('[data-deck]').forEach(b=>b.onclick=()=>openDeck(Number(b.dataset.deck)))}
function openDeck(index){const ds=getDecks(),d=ds[index];if(!d)return;const editor=document.getElementById('deckEditor');editor.classList.remove('hidden');const total=d.cards.reduce((s,c)=>s+(c.qty||0),0);const owned=collectionCounts();editor.innerHTML=`<div class="card" style="margin-top:16px"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center"><div><h3 style="margin:0">${esc(d.name)}</h3><div class="small">${total} cards</div></div><button class="secondary" id="deleteDeck">Delete</button></div><div style="margin-top:12px">${d.cards.length?d.cards.map((c,ci)=>`<div class="status" style="display:flex;justify-content:space-between;align-items:center;gap:10px"><span><b>${esc(c.name)}</b><br><span class="small">${esc(c.set||'')} • Qty ${c.qty}</span></span><button class="secondary" data-remove="${ci}" style="padding:9px 12px">−</button></div>`).join(''):'<p class="muted">No cards in this deck yet.</p>'}</div><h3 style="margin-bottom:8px">Add from Collection</h3><div>${owned.length?owned.map(c=>`<button class="choice full" style="margin-top:8px" data-add="${esc(cardKey(c))}"><span class="meta"><b>${esc(c.name)}</b><br><span class="small">${esc(c.set||'')} • You own ${c.qty}</span></span><span>＋</span></button>`).join(''):'<p class="muted">Scan and add cards to your collection first.</p>'}</div></div>`;document.getElementById('deleteDeck').onclick=()=>{if(confirm('Delete this deck?')){ds.splice(index,1);saveDecks(ds);editor.classList.add('hidden');renderDecks()}};editor.querySelectorAll('[data-remove]').forEach(b=>b.onclick=()=>{const ci=Number(b.dataset.remove);if(d.cards[ci].qty>1)d.cards[ci].qty--;else d.cards.splice(ci,1);saveDecks(ds);openDeck(index);renderDecks()});editor.querySelectorAll('[data-add]').forEach(b=>b.onclick=()=>{const key=b.dataset.add,c=owned.find(x=>cardKey(x)===key);if(!c)return;const existing=d.cards.find(x=>cardKey(x)===key);if(existing){if(existing.qty<c.qty)existing.qty++}else d.cards.push({...c,qty:1});saveDecks(ds);openDeck(index);renderDecks()})}

async function fetchCardData(c){
  if(c._scryfall)return c._scryfall;
  try{
    let r=await fetch('https://api.scryfall.com/cards/'+encodeURIComponent(c.id));
    if(r.ok){c._scryfall=await r.json();return c._scryfall}
  }catch(e){}
  try{
    let r=await fetch('https://api.scryfall.com/cards/named?exact='+encodeURIComponent(c.name));
    if(r.ok){c._scryfall=await r.json();return c._scryfall}
  }catch(e){}
  return c;
}
function chooseScore(c,style,colors){
  const d=c._scryfall||c, type=(d.type_line||'').toLowerCase(), oracle=(d.oracle_text||'').toLowerCase();
  let s=Math.random()*2;
  if(colors!=='any'){
    const want=colors.split('');
    const ci=(d.color_identity||[]);
    s += ci.some(x=>want.includes(x))*18;
    s -= ci.some(x=>!want.includes(x))*8;
  }
  if(style==='aggro') s += (type.includes('creature')?12:0)+(oracle.includes('attack')?8:0)+(oracle.includes('haste')?8:0);
  if(style==='control') s += (!type.includes('creature')?6:0)+(oracle.match(/counter|destroy|exile|draw|removal|return/)?10:0);
  if(style==='creatures') s += type.includes('creature')?20:0;
  if(style==='balanced') s += type.includes('creature')?8:0;
  if(style==='surprise') s += Math.random()*12;
  const mv=Number(d.cmc||0); if(mv>0)s += Math.max(0,7-Math.abs(mv-3))*2;
  return s;
}
async function autoBuildDeck(){
  const status=document.getElementById('buildStatus'), style=document.getElementById('buildStyle').value, colors=document.getElementById('buildColors').value;
  const pool=collectionCounts();
  if(!pool.length){status.classList.remove('hidden');status.textContent='Scan some cards into your collection first, then I can build the deck from them.';return}
  status.classList.remove('hidden');status.textContent='🔎 Looking up your cards and building the best deck I can…';
  document.getElementById('buildDeck').disabled=true;
  try{
    for(const c of pool) await fetchCardData(c);
    const lands=pool.filter(c=>(c._scryfall?.type_line||'').toLowerCase().includes('land'));
    const spells=pool.filter(c=>!(c._scryfall?.type_line||'').toLowerCase().includes('land'));
    const targetLands=Math.min(24,lands.reduce((s,c)=>s+c.qty,0));
    const sorted=spells.slice().sort((a,b)=>chooseScore(b,style,colors)-chooseScore(a,style,colors));
    const deckCards=[];
    function add(c,n){if(n>0)deckCards.push({...c,qty:n})}
    // Prefer up to 4 copies of each spell, respecting what the user owns.
    let remaining=60-targetLands;
    for(const c of sorted){
      if(remaining<=0)break;
      const n=Math.min(4,c.qty,remaining);
      if(n>0){add(c,n);remaining-=n}
    }
    // Fill remaining slots with lands from the user's collection.
    let landRemaining=targetLands;
    for(const c of lands){
      if(landRemaining<=0)break;
      const n=Math.min(c.qty,landRemaining);
      add(c,n);landRemaining-=n;
    }
    const missing=60-deckCards.reduce((s,c)=>s+c.qty,0);
    const name=document.getElementById('autoDeckName').value.trim() || 'Auto-Built Deck';
    const ds=getDecks();
    ds.unshift({name,cards:deckCards,autoBuilt:true,style,colors,missing});
    saveDecks(ds); renderDecks(); openDeck(0);
    status.textContent=missing?`✅ Deck built from your collection. It has ${60-missing} cards; you need ${missing} more card${missing===1?'':'s'} to reach 60.`:'✅ 60-card deck built from your collection!';
  }finally{
    document.getElementById('buildDeck').disabled=false;
  }
}
document.getElementById('buildDeck').onclick=autoBuildDeck;

document.getElementById('createDeck').onclick=()=>{const input=document.getElementById('deckName'),name=input.value.trim();if(!name){input.focus();return}const ds=getDecks();ds.unshift({name,cards:[]});saveDecks(ds);input.value='';renderDecks();openDeck(0)}
function esc(s){return String(s||'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function renderCollection(){const c=cards();document.getElementById('cards').innerHTML=c.length?c.map(x=>`<div class="card" style="margin:10px 0;padding:12px"><b>${esc(x.name)}</b><div class="small">${esc(x.set||'')}</div></div>`).join(''):'<p class="muted">No cards scanned yet.</p>'}
async function startCamera(){try{stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:'environment'},width:{ideal:1280},height:{ideal:1920}},audio:false});video.srcObject=stream;captureBtn.classList.remove('hidden');startBtn.textContent='Camera On';setStatus('Camera on. Keep the whole card visible and tap Scan This Card.')}catch(e){setStatus('Camera access was blocked. Allow Camera in Safari Settings and reload this page.')}}
function capture(){if(!stream)return;canvas.width=video.videoWidth;canvas.height=video.videoHeight;canvas.getContext('2d').drawImage(video,0,0,canvas.width,canvas.height);scanImage(canvas)}
async function scanImage(source){setStatus('Reading the card automatically…');captureBtn.disabled=true;try{const {data}=await Tesseract.recognize(source,'eng',{logger:m=>{if(m.status==='recognizing text')setStatus('Reading card… '+Math.round((m.progress||0)*100)+'%')}});const raw=data.text||'';const name=extractName(raw);const cn=extractCollectorNumber(raw);if(!name)throw new Error('No card name');setStatus('Found: '+name+' — checking printings…');const matches=await findPrintings(name,cn);if(!matches.length)throw new Error('Not found');showMatches(matches,name,cn)}catch(e){setStatus('I could not identify that card. Move closer, use bright light, keep the card flat, and try again.')}finally{captureBtn.disabled=false}}
function extractName(text){const lines=text.split(/\n+/).map(x=>x.replace(/[^A-Za-z0-9'’\- ,]/g,' ').replace(/\s+/g,' ').trim()).filter(Boolean);const bad=/^(magic|the gathering|mtg|wizards|legendary|creature|instant|sorcery|artifact|enchantment|planeswalker|basic land|land|token)$/i;const candidates=lines.slice(0,10).filter(x=>x.length>=3&&x.length<=45&&!bad.test(x));return candidates.sort((a,b)=>score(b)-score(a))[0]||''}function score(x){return x.split(' ').length*4+x.length/10-(/mana|flying|trample|deathtouch|when|whenever|target|add|draw|destroy/i.test(x)?20:0)}
function extractCollectorNumber(text){const hits=(text.match(/\b\d{1,4}(?:\s*\/\s*\d{1,4})?\b/g)||[]).map(x=>x.split('/')[0].trim());return hits.find(x=>Number(x)>0&&Number(x)<1000)||''}
async function findPrintings(name,cn){try{let q='!'+name;let r=await fetch('https://api.scryfall.com/cards/search?q='+encodeURIComponent(q)+'&unique=prints&order=released&dir=desc');if(r.ok){let d=await r.json();let arr=d.data||[];if(cn){const exact=arr.filter(c=>String(c.collector_number||'').split('/')[0]===String(cn));if(exact.length)return exact.slice(0,8)}return arr.slice(0,8)}}catch(e){}try{let r=await fetch('https://api.scryfall.com/cards/named?fuzzy='+encodeURIComponent(name));if(r.ok)return [await r.json()]}catch(e){}return []}
function showMatches(matches,name,cn){resultCard.classList.remove('hidden');resultEl.innerHTML=`<div class="name">${esc(name)}</div><div class="small">${cn?'Collector number detected: '+esc(cn)+'. ':''}Choose the matching printing:</div><div class="choices">${matches.map((c,i)=>{const img=c.image_uris?.small||c.card_faces?.[0]?.image_uris?.small||'';const price=c.prices?.usd?'$'+c.prices.usd:'Price unavailable';return `<button class="choice" data-i="${i}">${img?`<img src="${img}" alt="">`:''}<span class="meta"><b>${esc(c.set_name||'Unknown set')}</b><br><span class="small">${esc(c.set?.toUpperCase()||'')} • #${esc(c.collector_number||'?')}</span><br><span class="price">${price}</span></span></button>`}).join('')}</div>`;resultEl.querySelectorAll('.choice').forEach(b=>b.onclick=()=>showCard(matches[Number(b.dataset.i)]));resultCard.scrollIntoView({behavior:'smooth'})}
function showCard(c){resultCard.classList.remove('hidden');const img=c.image_uris?.normal||c.card_faces?.[0]?.image_uris?.normal||'';const price=c.prices?.usd?'$'+c.prices.usd:'Price unavailable';resultEl.innerHTML=`<div class="result">${img?`<img src="${img}" alt="">`:''}<div><div class="name">${esc(c.name)}</div><div class="small">${esc(c.set_name||'')} • #${esc(c.collector_number||'?')}</div><div class="price">${price}</div></div></div><button id="add" class="full">➕ Add to Collection</button>`;document.getElementById('add').onclick=()=>{const arr=cards();arr.unshift({name:c.name,set:c.set_name,setCode:c.set,id:c.id,collector:c.collector_number,price:c.prices?.usd||null});saveCards(arr);renderCollection();document.getElementById('add').textContent='✓ Added to Collection';document.getElementById('add').disabled=true};resultCard.scrollIntoView({behavior:'smooth'})}
startBtn.onclick=startCamera;captureBtn.onclick=capture;document.getElementById('again').onclick=()=>{resultCard.classList.add('hidden');setStatus('Ready for another scan.');window.scrollTo({top:0,behavior:'smooth'})};document.getElementById('scanTab').onclick=()=>{scanner.classList.remove('hidden');collection.classList.add('hidden');decks.classList.add('hidden')};document.getElementById('collectionTab').onclick=()=>{collection.classList.remove('hidden');scanner.classList.add('hidden');decks.classList.add('hidden');renderCollection()};document.getElementById('decksTab').onclick=()=>{decks.classList.remove('hidden');scanner.classList.add('hidden');collection.classList.add('hidden');renderDecks()};renderCollection();renderDecks();
</script>
</body></html>
